def main():
    file=input("write the name of the file : ")
    file=file.strip().lower()
    if "." in file:
        extension=file.rsplit(".",1)[1]
        match extension:
            case "gif":
                    print("image/gif")
            case"jpeg" |"jpg":
                    print("image/jpeg")
            case "png":
                    print("image/png")
            case "pdf":
                    print("application/pdf")
            case "txt":
                    print("text/plain")
            case "zip":
                    print("application/zip")
            case _:
                    print("application/octet-stream")
    else:
        print("application/octet-stream")

main()
